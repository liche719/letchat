# Copy this file to deploy/.env. Never commit deploy/.env.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_ROOT_PASSWORD=

# Leave blank until an administrator account email is known.
ADMIN_EMAILS=

# Optional AI feature. Keep disabled when no Kimi credential is configured.
KIMI_ENABLED=false
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=moonshot-v1-8k
